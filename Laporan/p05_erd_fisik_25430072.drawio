"1" source="produk" target="detail_pesanan" value="tercantum di (1 : 0..N)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#1f3a5f;strokeWidth=2;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" edge="1" parent="1" source="pesanan" target="pembayaran" value="dibayar melalui (1 : 0..1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#1f3a5f;strokeWidth=2;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" edge="1" parent="1" source="pesanan" target="pengiriman" value="dikirim melalui (1 : 0..N)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#1f3a5f;strokeWidth=2;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;fontStyle=2;fontSize=11;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;fontColor=#1f3a5f;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;ERD fisik Toko Serba Digital SDN&lt;/font&gt;" vertex="1"><mxGeometry x="680" y="30" width="700" height="45" as="geometry"/></mxCell><mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#999999;dashed=1;spacing=8;fontSize=11;" value="&lt;b&gt;Keterangan&lt;/b&gt;&lt;br&gt;PK = kunci primer &amp;nbsp; FK = kunci tamu &amp;nbsp; PK,FK = kunci primer komposit sekaligus kunci tamu&lt;br&gt;1 = tepat satu &amp;nbsp; 0..1 = nol atau satu &amp;nbsp; 0..N = nol atau banyak &amp;nbsp; 1..N = satu atau banyak&lt;br&gt;&lt;b&gt;ENUM&lt;/b&gt;: status_pembayaran = ('Belum Dibayar','Menunggu Konfirmasi','Lunas','Gagal'), default 'Belum Dibayar'; status_pengiriman = ('Belum Dikirim','Dalam Pengiriman','Terkirim','Gagal'), default 'Belum Dikirim'.&lt;br&gt;Tabel admin belum memiliki relasi ke tabel lain pada skrip DDL. Atribut turunan (subtotal, diskon 1% sesuai AB-10, total pembayaran) tidak disimpan (dihitung, Modul 4). AB-02 (maksimal 3 jenis barang per pesanan) dan AB-07 tidak dapat dijaga oleh constraint; ditangani trigger/transaksi." vertex="1"><mxGeometry x="40" y="930" width="760" height="150" as="geometry"/></mxCell><mxCell id="sign" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=12;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;SELVI DIA NURMALA&lt;/font&gt;&lt;br&gt;NIM 25430072" vertex="1"><mxGeometry x="1500" y="950" width="300" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>