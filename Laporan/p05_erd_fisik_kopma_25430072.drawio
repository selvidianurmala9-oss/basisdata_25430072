.1 = nol atau satu &amp;nbsp; 0..N = nol atau banyak &amp;nbsp; 1..N = satu atau banyak&lt;br&gt;Aksi referensial: detail_penjualan dan detail_pembelian ON DELETE CASCADE ke nota/faktur; FK lainnya ON DELETE RESTRICT, ON UPDATE CASCADE.&lt;br&gt;status_anggota: CHECK IN ('aktif','nonaktif'). Atribut turunan (subtotal, total, diskon) tidak disimpan." vertex="1"><mxGeometry x="40" y="830" width="760" height="120" as="geometry"/></mxCell><mxCell id="sign" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontStyle=1;fontSize=12;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;SELVI DIA NURMALA&lt;/font&gt;&lt;br&gt;NIM 25430072" vertex="1"><mxGeometry x="1500" y="860" width="300" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>